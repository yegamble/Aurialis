NEXT_PUBLIC_SEPARATION_API_URL=https://aurialis-core.yosefgamble.com
NEXT_PUBLIC_DEEP_ANALYSIS_API_URL=https://aurialis-core.yosefgamble.com
# Public Turnstile site key (same value committed in wrangler.jsonc "vars").
# Set at BUILD time so Next inlines it into the client bundle — a Worker
# runtime var alone is too late (NEXT_PUBLIC_* are inlined by `next build`).
# Only .env.production carries it, so plain `next dev` / e2e (no env) stay
# sitekey-less and fall back to the legacy multipart upload path.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADFNPdaK9423tgxr
