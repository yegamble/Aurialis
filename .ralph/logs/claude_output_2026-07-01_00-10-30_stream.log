{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015Crs9apBTvSL11g9P1ekD8","type":"tool_result","content":"232\t  });\n233\t\n234\t  describe(\"checkPhaseCoherence\", () => {\n235\t    it(\"returns high coherence when stems sum to original\", () => {\n236\t      const sr = 44100;\n237\t      const len = sr;\n238\t\n239\t      // Two stems that sum to the original\n240\t      const stem1 = sine(440, 0.3, 1, sr);\n241\t      const stem2 = sine(880, 0.3, 1, sr);\n242\t      const original = new Float32Array(len);\n243\t      for (let i = 0; i < len; i++) {\n244\t        original[i] = stem1[i] + stem2[i];\n245\t      }\n246\t\n247\t      const score = checkPhaseCoherence([stem1, stem2], original, sr);\n248\t\n249\t      expect(score).toBeGreaterThan(80);\n250\t    });\n251\t\n252\t    it(\"returns low coherence when stems are phase-inverted\", () => {\n253\t      const sr = 44100;\n254\t      const len = sr;\n255\t\n256\t      const original = sine(440, 0.5, 1, sr);\n257\t      // Phase-inverted stem\n258\t      const inverted = new Float32Array(len);\n259\t      for (let i = 0; i < len; i++) inverted[i] = -original[i];\n260\t\n261\t      const score = checkPhaseCoherence([inverted], original, sr);\n262\t\n263\t      expect(score).toBeLessThan(50);\n264\t    });\n265\t\n266\t    it(\"returns 0-100 range\", () => {\n267\t      const sr = 44100;\n268\t      const stem = sine(440, 0.5, 1, sr);\n269\t      const original = sine(440, 0.5, 1, sr);\n270\t\n271\t      const score = checkPhaseCoherence([stem], original, sr);\n272\t\n273\t      expect(score).toBeGreaterThanOrEqual(0);\n274\t      expect(score).toBeLessThanOrEqual(100);\n275\t    });\n276\t\n277\t    it(\"handles empty stems array\", () => {\n278\t      const original = sine(440, 0.5, 1);\n279\t      const score = checkPhaseCoherence([], original, 44100);\n280\t      expect(score).toBe(0);\n281\t    });\n282\t  });\n283\t});\n284\t"}]},"parent_tool_use_id":null,"session_id":"243c3f7c-ee0e-426f-a231-33e2ba1d8e5c","uuid":"55e476d4-97fb-4ae4-a70d-e233c3c0d257","timestamp":"2026-07-01T04:13:51.985Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/yosefgamble/github/Aurialis/src/lib/audio/__tests__/smart-repair.test.ts","content":"  });\n\n  describe(\"checkPhaseCoherence\", () => {\n    it(\"returns high coherence when stems sum to original\", () => {\n      const sr = 44100;\n      const len = sr;\n\n      // Two stems that sum to the original\n      const stem1 = sine(440, 0.3, 1, sr);\n      const stem2 = sine(880, 0.3, 1, sr);\n      const original = new Float32Array(len);\n      for (let i = 0; i < len; i++) {\n        original[i] = stem1[i] + stem2[i];\n      }\n\n      const score = checkPhaseCoherence([stem1, stem2], original, sr);\n\n      expect(score).toBeGreaterThan(80);\n    });\n\n    it(\"returns low coherence when stems are phase-inverted\", () => {\n      const sr = 44100;\n      const len = sr;\n\n      const original = sine(440, 0.5, 1, sr);\n      // Phase-inverted stem\n      const inverted = new Float32Array(len);\n      for (let i = 0; i < len; i++) inverted[i] = -original[i];\n\n      const score = checkPhaseCoherence([inverted], original, sr);\n\n      expect(score).toBeLessThan(50);\n    });\n\n    it(\"returns 0-100 range\", () => {\n      const sr = 44100;\n      const stem = sine(440, 0.5, 1, sr);\n      const original = sine(440, 0.5, 1, sr);\n\n      const score = checkPhaseCoherence([stem], original, sr);\n\n      expect(score).toBeGreaterThanOrEqual(0);\n      expect(score).toBeLessThanOrEqual(100);\n    });\n\n    it(\"handles empty stems array\", () => {\n      const original = sine(440, 0.5, 1);\n      const score = checkPhaseCoherence([], original, 44100);\n      expect(score).toBe(0);\n    });\n  });\n});\n","numLines":53,"startLine":232,"totalLines":284}}}
