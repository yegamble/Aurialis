{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018Ju6v9YCP4JaRKbc8mEbGK","type":"tool_result","content":"1\timport { describe, it, expect, vi } from \"vitest\";\n2\timport { render, screen } from \"@testing-library/react\";\n3\timport { StemsView } from \"../StemsView\";\n4\t\n5\t// Keep the unified shell deterministic.\n6\tvi.mock(\"@/hooks/use-is-lg-viewport\", () => ({\n7\t  useIsLgViewport: () => true,\n8\t}));\n9\t\n10\t// next/navigation's useRouter needs the App Router context, absent under RTL.\n11\tvi.mock(\"next/navigation\", () => ({\n12\t  useRouter: () => ({\n13\t    push: vi.fn(),\n14\t    replace: vi.fn(),\n15\t    back: vi.fn(),\n16\t    prefetch: vi.fn(),\n17\t  }),\n18\t}));\n19\t\n20\tdescribe(\"StemsView\", () => {\n21\t  it(\"renders the unified shell + the stem-upload landing when no stems are loaded\", () => {\n22\t    render(<StemsView />);\n23\t    // Direction A: the nav Sidebar is present (Smart Split is this screen).\n24\t    expect(screen.getByTestId(\"sidebar\")).toBeInTheDocument();\n25\t    expect(\n26\t      screen.getByRole(\"button\", { name: /Smart Split/i }),\n27\t    ).toBeInTheDocument();\n28\t    // No stems yet → the upload dropzone is shown.\n29\t    expect(screen.getByText(/Drop audio files or ZIP/i)).toBeInTheDocument();\n30\t  });\n31\t});\n32\t"}]},"parent_tool_use_id":null,"session_id":"243c3f7c-ee0e-426f-a231-33e2ba1d8e5c","uuid":"51d520ca-3225-4f09-b709-3e12636cf72f","timestamp":"2026-07-01T04:12:36.974Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/yosefgamble/github/Aurialis/src/components/mixer/__tests__/StemsView.test.tsx","content":"import { describe, it, expect, vi } from \"vitest\";\nimport { render, screen } from \"@testing-library/react\";\nimport { StemsView } from \"../StemsView\";\n\n// Keep the unified shell deterministic.\nvi.mock(\"@/hooks/use-is-lg-viewport\", () => ({\n  useIsLgViewport: () => true,\n}));\n\n// next/navigation's useRouter needs the App Router context, absent under RTL.\nvi.mock(\"next/navigation\", () => ({\n  useRouter: () => ({\n    push: vi.fn(),\n    replace: vi.fn(),\n    back: vi.fn(),\n    prefetch: vi.fn(),\n  }),\n}));\n\ndescribe(\"StemsView\", () => {\n  it(\"renders the unified shell + the stem-upload landing when no stems are loaded\", () => {\n    render(<StemsView />);\n    // Direction A: the nav Sidebar is present (Smart Split is this screen).\n    expect(screen.getByTestId(\"sidebar\")).toBeInTheDocument();\n    expect(\n      screen.getByRole(\"button\", { name: /Smart Split/i }),\n    ).toBeInTheDocument();\n    // No stems yet → the upload dropzone is shown.\n    expect(screen.getByText(/Drop audio files or ZIP/i)).toBeInTheDocument();\n  });\n});\n","numLines":32,"startLine":1,"totalLines":32}}}
