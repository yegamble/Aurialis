ull);\n636\t                  loadStems([pendingSingleFile]);\n637\t                }}\n638\t                className=\"w-full mt-2 py-2 text-[rgba(255,255,255,0.3)] text-xs hover:text-white transition-colors\"\n639\t              >\n640\t                Skip separation — load as single track\n641\t              </button>\n642\t            </div>\n643\t          )}\n644\t\n645\t          {/* Separation progress */}\n646\t          {(isSeparating || separationError) && (\n647\t            <SeparationProgressCard\n648\t              status={separationCardStatus}\n649\t              activeStage={separationActiveStage}\n650\t              progress={separationStatus?.progress ?? 0}\n651\t              elapsedSec={separationElapsedSec}\n652\t              errorDetails={separationError}\n653\t              stageDurationsMs={separationView.stageDurationsMs}\n654\t              failedAtStageLabel={separationView.failedAtStageLabel}\n655\t              stageTraceText={separationView.stageTraceText}\n656\t            />\n657\t          )}\n658\t\n659\t          {/* Backend unavailable warning */}\n660\t          {backendAvailable === false && !hasStemsLoaded && (\n661\t            <div className=\"rounded-lg bg-yellow-500/10 border border-yellow-500/20 px-4 py-3 text-yellow-400 text-xs\">\n662\t              Separation backend not available. Run <code className=\"bg-[rgba(255,255,255,0.1)] px-1 rounded\">docker compose up</code> to enable Smart Split.\n663\t              Multi-file and ZIP uploads still work.\n664\t            </div>\n665\t          )}\n666\t\n667\t          {/* Upload area (always visible to allow adding more stems) */}\n668\t          {!isSeparating && !showModelSelect && (\n669\t            <StemUpload\n670\t              onStemsLoaded={handleStemsLoaded}\n671\t              isLoading={isLoadingStems}\n672\t              error={loadError}\n673\t              stemCount={stems.length}\n674\t            />\n675\t          )}"}]},"parent_tool_use_id":null,"ses