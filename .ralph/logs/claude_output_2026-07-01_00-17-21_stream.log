er(status, elapsedMs);\n            },\n          }\n        );\n\n        if (pollResult.kind === \"cancelled\") {\n          setIsSeparating(false);\n          return;\n        }\n\n        const finalStatus = pollResult.final;\n\n        // Download sub-stems\n        emitSeparationDownloading(runId);","numLines":55,"startLine":377,"totalLines":792}}}
