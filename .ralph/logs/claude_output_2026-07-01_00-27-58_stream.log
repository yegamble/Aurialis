{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C1ytC4gSXnDvgdgMCsAKNY","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport { useEffect, useState } from \"react\";\n4\timport { useRouter } from \"next/navigation\";\n5\timport { motion, AnimatePresence } from \"motion/react\";\n6\timport { Play, Pause, SkipBack, Music } from \"lucide-react\";\n7\timport { WaveformDisplay } from \"@/components/visualization/WaveformDisplay\";\n8\timport { SpectrumDisplay } from \"@/components/visualization/SpectrumDisplay\";\n9\timport { LevelMeter } from \"@/components/visualization/LevelMeter\";\n10\timport { Goniometer } from \"@/components/visualization/Goniometer\";\n11\timport { SimpleMastering } from \"@/components/mastering/SimpleMastering\";\n12\timport { AdvancedMastering } from \"@/components/mastering/AdvancedMastering\";\n13\timport { DeepMastering } from \"@/components/mastering/DeepMastering\";\n14\timport { BigReadout } from \"@/components/mastering/BigReadout\";\n15\timport { Sidebar, type ShellScreen } from \"@/components/shell/Sidebar\";\n16\timport { ABToggle } from \"@/components/mastering/ABToggle\";\n17\timport { MasterToolbar, type MasterMode } from \"@/components/mastering/MasterToolbar\";\n18\timport { ExportView } from \"@/components/export/ExportView\";\n19\timport { useAudioStore } from \"@/lib/stores/audio-store\";\n20\timport { useUIStore } from \"@/lib/stores/ui-store\";\n21\timport { useSettingsStore } from \"@/lib/stores/settings-store\";\n22\timport { useDeepStore } from \"@/lib/stores/deep-store\";\n23\timport { useLibraryStore } from \"@/lib/stores/library-store\";\n24\timport { useAudioEngine } from \"@/hooks/useAudioEngine\";\n25\timport { useVisualization } from \"@/hooks/useVisualization\";\n26\timport { useIsLgViewport } from \"@/hooks/use-is-lg-viewport\";\n27\timport { applyIntensity, PLATFORM_PRESETS, type GenreName } from \"@/lib/audio/presets\";\n28\timport { analyzeAudio } from \"@/lib/audio/analysis\";\n29\timport { computeAutoMasterParams } from \"@/lib/audio/auto-master\";\n30\timport {\n31\t  emitStage,\n32\t  emitErrorTrace,\n33\t  newRunId,\n34\t} from \"@/lib/analysis-stage/emitter\";\n35\timport { useAnalysisStageStore } from \"@/lib/stores/analysis-stage-store\";\n36\timport { exportWav } from \"@/lib/audio/export\";\n37\timport { buildExportOptions } from \"@/lib/audio/export-options\";\n38\timport type { ExportSettings } from \"@/components/export/ExportPanel\";\n39\timport type { ToggleName, AudioParams } from \"@/types/mastering\";\n40\timport {\n41\t  applySimpleToggles,\n42\t  applyTonePreset,\n43\t  matchesOutputPreset,\n44\t  OUTPUT_PRESET_PLATFORM_MAP,\n45\t  type OutputPresetName,\n46\t  type TonePresetName,\n47\t} from \"@/lib/audio/ui-presets\";\n48\t\n49\tconst INITIAL_TOGGLES: Record<ToggleName, boolean> = {\n50\t  cleanup: false,\n51\t  warm: false,\n52\t  bright: false,\n53\t  wide: false,\n54\t  loud: false,\n55\t  deharsh: false,\n56\t  glueComp: false,\n57\t};\n58\t\n59\tfunction formatTime(s: number): string {\n60\t  const m = Math.floor(s / 60);\n61\t  const sec = Math.floor(s % 60);\n62\t  return `${m}:${sec.toString().padStart(2, \"0\")}`;\n63\t}\n64\t\n65\tfunction formatMbGr(db: number): string {\n66\t  if (!Number.isFinite(db) || db === 0) return \"0.0\";\n67\t  return db.toFixed(1);\n68\t}\n69\t\n70\tfunction mbGrColorClass(db: number): string {\n71\t  const g = -db;\n72\t  if (g >= 6) return \"text-red-400\";\n73\t  if (g >= 3) return \"text-amber-400\";\n74\t  return \"\";\n75\t}\n76\t\n77\texport default function MasterPage() {\n78\t  const router = useRouter();\n79\t  const file = useAudioStore((s) => s.file);\n80\t  const { mode, setMode } = useUIStore();\n81\t  const proMode = useSettingsStore((s) => s.proMode);\n82\t  const setProMode = useSettingsStore((s) => s.setProMode);\n83\t  const isLgViewport = useIsLgViewport();\n84\t\n85\t  // Real audio engine\n86\t  const {\n87\t    isPlaying,\n88\t    isLoaded,\n89\t  